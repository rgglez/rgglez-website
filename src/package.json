{
  "name": "src",
  "type": "module",
  "version": "5.5.1",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "astro dev",
    "build:astro": "astro build",
    "build:pagefind": "pagefind --site dist/client",
    "build:og": "bun scripts/generate-og.ts",
    "build": "NODE_OPTIONS='--max-old-space-size=4096' astro build && pagefind --site dist/client",
    "preview": "astro preview",
    "sync": "astro sync",
    "astro": "astro",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint": "eslint .",
    "sync:portfolio": "node scripts/sync-portfolio.mjs",
    "i18n:extract": "find src -name '*.astro' | sort | xgettext -f - -L JavaScript --from-code=UTF-8 --keyword=_ --keyword=_n:1,2 --flag=_:1:javascript-format --flag=_n:1:javascript-format --flag=_n:2:javascript-format --package-name=rgglez-website -o src/i18n/messages.pot",
    "i18n:update": "for l in es fr de zh en; do msgmerge --quiet --update --backup=none --no-fuzzy-matching src/i18n/$l/messages.po src/i18n/messages.pot; done && msgen src/i18n/en/messages.po -o src/i18n/en/messages.po",
    "i18n:json": "for l in es en fr de zh; do msgfmt -c --statistics -o /dev/null src/i18n/$l/messages.po && perl scripts/po2json.pl --po src/i18n/$l/messages.po --json src/i18n/$l/messages.json --context app || exit 1; done"
  },
  "dependencies": {
    "@astrojs/cloudflare": "13.5.2",
    "@astrojs/mdx": "5.0.6",
    "@astrojs/react": "5.0.5",
    "@astrojs/rss": "4.0.18",
    "@astrojs/sitemap": "3.7.2",
    "@giscus/react": "^3.1.0",
    "@resvg/resvg-js": "^2.6.2",
    "@rgglez/astro-aside": "^0.1.3",
    "@rgglez/astro-collapsiblecode": "^0.1.1",
    "@rgglez/astro-downloadchecklist": "^0.1.4",
    "@rgglez/astro-downloadtable": "^0.1.5",
    "@rgglez/astro-i18n-gettext": "^0.1.0",
    "@rgglez/astro-p5js-sketch": "^0.1.1",
    "@rgglez/astro-seo": "^0.1.2",
    "@rgglez/astro-tocbutton": "0.1.5",
    "@rgglez/astro-ytembed": "0.1.4",
    "@rgglez/music-laserharp": "^0.1.0",
    "@rgglez/shiki-pddl": "^0.0.3",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "astro": "6.3.5",
    "astro-expressive-code": "^0.41.7",
    "dayjs": "^1.11.21",
    "flag-icons": "^7.5.0",
    "lodash.kebabcase": "^4.1.1",
    "mermaid": "^11.15.0",
    "p5": "^2.3.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "rehype-katex": "^7.0.1",
    "remark-collapse": "^0.1.2",
    "remark-math": "^6.0.0",
    "remark-toc": "^9.0.0",
    "satori": "^0.18.4",
    "sharp": "^0.34.5",
    "slugify": "^1.6.9",
    "sprintf-js": "^1.1.3",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@pagefind/default-ui": "^1.5.2",
    "@shikijs/transformers": "^3.23.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/lodash.kebabcase": "^4.1.9",
    "@types/sprintf-js": "^1.1.4",
    "@typescript-eslint/parser": "^8.60.1",
    "eslint": "^9.39.4",
    "eslint-plugin-astro": "^1.7.0",
    "globals": "^16.5.0",
    "pagefind": "^1.5.2",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.1"
  }
}
