---
export const prerender = true;
import type { GetStaticPaths } from "astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import PortfolioTabs from "@/components/PortfolioTabs.astro";
import { SITE } from "@/config";
import { useGettext, sprintf } from "@/i18n";
import type { PortfolioData } from "@/data/portfolio/types";
import reposJson from "@/data/portfolio/repos.json";

export const getStaticPaths = (() => {
  return SITE.supportedLangs.map(lang => ({ params: { lang } }));
}) satisfies GetStaticPaths;

const data = reposJson as PortfolioData;

const { _ } = useGettext(Astro);
const layoutProps = {
  title: sprintf("%s | %s", _("Portfolio"), SITE.title),
  description: _("Public GitHub projects by language and topics."),
};
---

<Layout {...layoutProps}>
  <Header />
  <main id="main-content" class="app-layout py-8">
    <h1 class="mb-2 text-2xl font-semibold">{_("Portfolio")}</h1>
    <p class="mb-8 text-foreground/75">
      {layoutProps.description}
    </p>
    <PortfolioTabs data={data} />
  </main>
  <Footer />
</Layout>
