---
export const prerender = true;
import Main from "@/layouts/Main.astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { SITE } from "@/config";
import { LANG_NAMES } from "@/utils/langNames";

export async function getStaticPaths() {
  return SITE.supportedLangs.map(lang => ({ params: { lang } }));
}

const { lang } = Astro.params;
const supportedLangs = SITE.supportedLangs;
const backUrl = SITE.showBackButton ? `${Astro.url.pathname}` : `/${lang}/`;
---

<Layout title={`Search | ${SITE.title}`}>
  <Header />
  <Main pageTitle="Search" pageDesc="Search any article ...">
    <div
      id="pf-root"
      data-backurl={backUrl}
      data-lang={lang}
      data-supported={JSON.stringify(supportedLangs)}
    >
      <input
        id="pf-input"
        type="search"
        placeholder="Search ..."
        autocomplete="off"
        class="w-full rounded border border-border bg-background px-3 py-2 outline-none focus-visible:outline focus-visible:outline-1 focus-visible:outline-accent"
      />

      <div id="pf-dev-warning" class="mt-4 hidden rounded bg-muted/75 p-4 space-y-2">
        <p><strong>DEV mode warning!</strong> You need to build the project at least once to see search results during development.</p>
        <code class="block bg-black text-white px-2 py-1 rounded">make build</code>
      </div>

      <div class="mt-6 grid grid-cols-1 gap-6 sm:grid-cols-[12rem_1fr]">
        <aside>
          <ul id="pf-filters" class="space-y-2">
            {supportedLangs.map(l => (
              <li>
                <label class="flex items-center gap-2 cursor-pointer">
                  <input
                    type="checkbox"
                    value={l}
                    checked={l === lang}
                    class="pf-lang-cb accent-accent"
                  />
                  <span>{LANG_NAMES[l] ?? l.toUpperCase()}</span>
                  <span class="pf-count text-foreground/60" data-lang={l}>(0)</span>
                </label>
              </li>
            ))}
          </ul>
        </aside>

        <section>
          <p id="pf-status" class="text-sm text-foreground/60"></p>
          <ol id="pf-results" class="mt-2 space-y-6"></ol>
        </section>
      </div>
    </div>
  </Main>
  <Footer />
</Layout>

<script>
  // ── types ──────────────────────────────────────────────────────────────────
  type PFResultData = { url: string; meta?: { title?: string }; excerpt?: string };
  type PFResult    = { id: string; data: () => Promise<PFResultData> };
  type PFResponse  = { results: PFResult[] };
  type PFModule    = {
    options?:    (opts: Record<string, unknown>) => Promise<void>;
    mergeIndex:  (path: string, opts?: Record<string, unknown>) => Promise<void>;
    search:      (term: string) => Promise<PFResponse>;
  };

  // ── state ──────────────────────────────────────────────────────────────────
  const PAGE_SIZE  = 50;
  const DEBOUNCE   = 300;

  let pf: PFModule | null = null;
  let pfFailed = false;
  let activeTerm = "";
  let cache: PFResultData[] = [];

  // ── pagefind init ──────────────────────────────────────────────────────────
  // Pagefind puts each language in its own index bucket and by default only
  // searches the bucket matching html[lang]. We use mergeIndex to register all
  // remaining language buckets so pf.search() covers every language.
  // The full-origin URL is required to bypass pagefind's same-path dedup guard
  // (it skips mergeIndex when basePath.startsWith(indexPath), which would fire
  // for a plain "/pagefind/" path but not for "https://host/pagefind/").
  async function loadPf(): Promise<PFModule | null> {
    if (pf)       return pf;
    if (pfFailed) return null;

    if (import.meta.env.DEV) {
      pfFailed = true;
      document.getElementById("pf-dev-warning")?.classList.remove("hidden");
      return null;
    }

    try {
      const pfUrl = "/pagefind/pagefind.js";
      const mod = (await import(/* @vite-ignore */ pfUrl)) as PFModule;
      if (mod.options) await mod.options({ baseUrl: "/" });

      const root      = document.getElementById("pf-root");
      const langs     = JSON.parse(root?.dataset.supported ?? "[]") as string[];
      const primary   = (document.documentElement.lang ?? "").toLowerCase();
      const indexBase = `${window.location.origin}/pagefind/`;

      for (const lang of langs) {
        if (lang === primary) continue;           // primary bucket loaded automatically
        try { await mod.mergeIndex(indexBase, { language: lang }); }
        catch { /* language absent from this index */ }
      }

      pf = mod;
      return pf;
    } catch (err) {
      pfFailed = true;
      console.warn("[search] pagefind unavailable:", err);
      document.getElementById("pf-dev-warning")?.classList.remove("hidden");
      return null;
    }
  }

  // ── helpers ────────────────────────────────────────────────────────────────
  function langOfUrl(url: string): string {
    // URL pattern: /{lang}/posts/... → first path segment = language code
    return url.split(/[?#]/)[0].split("/").filter(Boolean)[0] ?? "";
  }

  function checkedLangs(): Set<string> {
    return new Set(
      Array.from(document.querySelectorAll<HTMLInputElement>(".pf-lang-cb:checked"))
        .map(cb => cb.value)
    );
  }

  function esc(s: string): string {
    return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;").replace(/'/g, "&#39;");
  }

  function setStatus(msg: string) {
    const el = document.getElementById("pf-status");
    if (el) el.textContent = msg;
  }

  function setCounts(counts: Record<string, number>) {
    document.querySelectorAll<HTMLElement>(".pf-count").forEach(el => {
      el.textContent = `(${counts[el.dataset.lang ?? ""] ?? 0})`;
    });
  }

  function renderResults(items: PFResultData[]) {
    const list = document.getElementById("pf-results");
    if (!list) return;
    list.innerHTML = items.map(d => `
      <li>
        <a href="${esc(d.url)}" class="text-[#161d2e] dark:text-white underline decoration-dashed underline-offset-4 decoration-[#a1bfef] dark:decoration-[#234c77] hover:decoration-accent">
          ${esc(d.meta?.title ?? d.url)}
        </a>
        <div class="text-sm text-foreground/70 mt-1">${d.excerpt ?? ""}</div>
      </li>`).join("");
  }

  // ── display cache filtered by checked language checkboxes ──────────────────
  function paintFromCache() {
    // Compute per-language hit counts from the full result set
    const counts: Record<string, number> = {};
    for (const d of cache) {
      const l = langOfUrl(d.url);
      if (l) counts[l] = (counts[l] ?? 0) + 1;
    }
    setCounts(counts);

    const selected = checkedLangs();
    if (selected.size === 0) {
      document.getElementById("pf-results")!.innerHTML = "";
      setStatus("No language selected.");
      return;
    }

    const filtered = cache.filter(d => selected.has(langOfUrl(d.url)));
    const slice    = filtered.slice(0, PAGE_SIZE);
    renderResults(slice);

    const total = filtered.length;
    setStatus(
      total === 0
        ? "No results."
        : `${total} result${total !== 1 ? "s" : ""}${total > slice.length ? ` (showing ${slice.length})` : ""}.`
    );
  }

  // ── search ─────────────────────────────────────────────────────────────────
  async function doSearch(term: string) {
    activeTerm = term;

    if (!term.trim()) {
      cache = [];
      setCounts({});
      document.getElementById("pf-results")!.innerHTML = "";
      setStatus("");
      return;
    }

    const mod = await loadPf();
    if (!mod) return;

    const res = await mod.search(term);
    if (term !== activeTerm) return; // stale — newer search in flight

    const data = await Promise.all(res.results.map(r => r.data()));
    if (term !== activeTerm) return;

    // Deduplicate by URL (same page can appear in multiple merged buckets)
    const seen = new Set<string>();
    cache = data.filter(d => {
      if (seen.has(d.url)) return false;
      seen.add(d.url);
      return true;
    });

    paintFromCache();
  }

  // ── URL sync ───────────────────────────────────────────────────────────────
  function syncUrl(term: string) {
    const params = new URLSearchParams(window.location.search);
    if (term) { params.set("q", term); }
    else      { params.delete("q"); }
    history.replaceState(history.state, "", term ? `?${params}` : window.location.pathname);

    const root    = document.getElementById("pf-root");
    const backUrl = root?.dataset.backurl ?? "/";
    sessionStorage.setItem("backUrl", term ? `${backUrl}?${params}` : backUrl);
  }

  // ── init ───────────────────────────────────────────────────────────────────
  function debounce<T extends (...a: unknown[]) => void>(fn: T, ms: number) {
    let t: ReturnType<typeof setTimeout> | undefined;
    return (...a: Parameters<T>) => { clearTimeout(t); t = setTimeout(() => fn(...a), ms); };
  }

  function init() {
    const root = document.getElementById("pf-root");
    if (!root || root.dataset.pfInit === "1") return;
    root.dataset.pfInit = "1";

    const input = document.getElementById("pf-input") as HTMLInputElement | null;
    if (!input) return;

    const debouncedSearch = debounce((term: string) => {
      syncUrl(term);
      doSearch(term);
    }, DEBOUNCE);

    input.addEventListener("input", () => debouncedSearch(input.value));

    // Checkbox toggle: re-filter from cache, no new pagefind search needed
    document.querySelectorAll<HTMLInputElement>(".pf-lang-cb").forEach(cb => {
      cb.addEventListener("change", () => paintFromCache());
    });

    // Restore search from URL ?q=
    const q = new URLSearchParams(window.location.search).get("q");
    if (q) { input.value = q; doSearch(q); }
  }

  document.addEventListener("astro:after-swap", init);
  init();
</script>
