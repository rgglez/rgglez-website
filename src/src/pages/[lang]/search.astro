---
export const prerender = true;
import Main from "@/layouts/Main.astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { SITE } from "@/config";
import { LANG_NAMES } from "@/utils/langNames";

export async function getStaticPaths() {
  return SITE.supportedLangs.map(lang => ({ params: { lang } }));
}

const { lang } = Astro.params;
const supportedLangs = SITE.supportedLangs;
const backUrl = SITE.showBackButton ? `${Astro.url.pathname}` : `/${lang}/`;
---

<Layout title={`Search | ${SITE.title}`}>
  <Header />
  <Main pageTitle="Search" pageDesc="Search any article ...">
    <div
      id="pf-root"
      data-backurl={backUrl}
      data-supported={JSON.stringify(supportedLangs)}
    >
      <input
        id="pf-input"
        type="search"
        placeholder="Search ..."
        autocomplete="off"
        class="w-full rounded border border-border bg-background px-3 py-2 outline-none focus-visible:outline focus-visible:outline-1 focus-visible:outline-accent"
      />

      <div id="pf-dev-warning" class="mt-4 hidden rounded bg-muted/75 p-4 space-y-2">
        <p><strong>DEV mode warning!</strong> You need to build the project at least once to see search results during development.</p>
        <code class="block bg-black text-white px-2 py-1 rounded">make build</code>
      </div>

      <div class="mt-6 grid grid-cols-1 gap-6 sm:grid-cols-[12rem_1fr]">
        <aside>
          <ul id="pf-filters" class="space-y-2">
            {supportedLangs.map(l => (
              <li>
                <label class="flex items-center gap-2 cursor-pointer">
                  <input
                    type="checkbox"
                    value={l}
                    checked={l === lang}
                    class="pf-lang-cb accent-accent"
                  />
                  <span>{LANG_NAMES[l] ?? l.toUpperCase()}</span>
                </label>
              </li>
            ))}
          </ul>
        </aside>

        <section>
          <p id="pf-status" class="text-sm text-foreground/60"></p>
          <ol id="pf-results" class="mt-2 space-y-6"></ol>
        </section>
      </div>
    </div>
  </Main>
  <Footer />
</Layout>

<script>
  // ── types ────────────────────────────────────────────────────────────────────
  type PFData     = { url: string; meta?: { title?: string }; excerpt?: string };
  type PFResult   = { id: string; data: () => Promise<PFData> };
  type PFResponse = { results: PFResult[] };
  type PFModule   = {
    options?:    (opts: Record<string, unknown>) => Promise<void>;
    mergeIndex:  (path: string, opts?: Record<string, unknown>) => Promise<void>;
    search:      (term: string) => Promise<PFResponse>;
  };

  // ── constants ────────────────────────────────────────────────────────────────
  const PAGE_SIZE = 50;
  const DEBOUNCE  = 300;

  // ── module-level state ───────────────────────────────────────────────────────
  let pf: PFModule | null = null;
  let pfFailed = false;
  let searchSeq = 0; // incremented each search; used to discard stale results

  // ── pagefind loader ──────────────────────────────────────────────────────────
  // Pagefind puts each language in its own index bucket and by default only
  // searches the bucket matching html[lang]. mergeIndex registers the remaining
  // language buckets so pf.search() fans out to all of them.
  //
  // The full-origin URL bypasses pagefind's same-path dedup guard:
  //   primary.basePath = "/pagefind/"
  //   guard: primary.basePath.startsWith(indexPath)  →  "/pagefind/".startsWith("https://host/pagefind/") = false ✓
  async function loadPf(): Promise<PFModule | null> {
    if (pf)       return pf;
    if (pfFailed) return null;

    if (import.meta.env.DEV) {
      pfFailed = true;
      document.getElementById("pf-dev-warning")?.classList.remove("hidden");
      return null;
    }

    try {
      const pfUrl = "/pagefind/pagefind.js";
      const mod = (await import(/* @vite-ignore */ pfUrl)) as PFModule;
      if (mod.options) await mod.options({ baseUrl: "/" });

      const root      = document.getElementById("pf-root");
      const langs     = JSON.parse(root?.dataset.supported ?? "[]") as string[];
      const primary   = (document.documentElement.lang ?? "").toLowerCase();
      const indexBase = `${window.location.origin}/pagefind/`;

      for (const l of langs) {
        if (l === primary) continue; // primary bucket loaded automatically
        try { await mod.mergeIndex(indexBase, { language: l }); }
        catch { /* language absent from this index */ }
      }

      pf = mod;
      return pf;
    } catch (err) {
      pfFailed = true;
      console.warn("[search] pagefind unavailable:", err);
      document.getElementById("pf-dev-warning")?.classList.remove("hidden");
      return null;
    }
  }

  // ── helpers ──────────────────────────────────────────────────────────────────
  function checkedLangs(): string[] {
    return Array.from(document.querySelectorAll<HTMLInputElement>(".pf-lang-cb:checked"))
      .map(cb => cb.value);
  }

  function langOfUrl(url: string): string {
    return url.split(/[?#]/)[0].split("/").filter(Boolean)[0] ?? "";
  }

  function esc(s: string): string {
    return s.replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;")
            .replace(/"/g,"&quot;").replace(/'/g,"&#39;");
  }

  function setStatus(msg: string) {
    const el = document.getElementById("pf-status");
    if (el) el.textContent = msg;
  }

  function clearResults() {
    document.getElementById("pf-results")!.innerHTML = "";
  }

  function renderResults(items: PFData[]) {
    document.getElementById("pf-results")!.innerHTML = items.map(d => `
      <li>
        <a href="${esc(d.url)}" class="text-[#161d2e] dark:text-white underline decoration-dashed underline-offset-4 decoration-[#a1bfef] dark:decoration-[#234c77] hover:decoration-accent">
          ${esc(d.meta?.title ?? d.url)}
        </a>
        <div class="text-sm text-foreground/70 mt-1">${d.excerpt ?? ""}</div>
      </li>`).join("");
  }

  // ── search ───────────────────────────────────────────────────────────────────
  // Spec:
  //   - Run when input changes (debounced) or when a language checkbox changes.
  //   - Search only the checked languages using pagefind's native filter API.
  //     Each merged bucket receives `filters: { lang: [checked…] }` and returns
  //     only pages whose data-pagefind-filter matches — no client-side URL
  //     parsing needed.
  async function doSearch() {
    const seq  = ++searchSeq;
    const input = document.getElementById("pf-input") as HTMLInputElement | null;
    const term  = input?.value.trim() ?? "";
    const langs = checkedLangs();

    if (!term) {
      clearResults();
      setStatus("");
      return;
    }

    if (langs.length === 0) {
      clearResults();
      setStatus("No language selected.");
      return;
    }

    const mod = await loadPf();
    if (!mod || seq !== searchSeq) return;

    const res = await mod.search(term);
    if (seq !== searchSeq) return;

    const data = await Promise.all(res.results.map(r => r.data()));
    if (seq !== searchSeq) return;

    // Deduplicate by URL (a page can appear in multiple merged buckets)
    const seen   = new Set<string>();
    const unique = data.filter(d => !seen.has(d.url) && seen.add(d.url));

    // Client-side language filter (pagefind filter API broken for arrays)
    const checkedSet = new Set(langs);
    const filtered   = unique.filter(d => checkedSet.has(langOfUrl(d.url)));
    const slice      = filtered.slice(0, PAGE_SIZE);

    renderResults(slice);
    const total = filtered.length;
    setStatus(
      total === 0
        ? "No results."
        : `${total} result${total !== 1 ? "s" : ""}${total > PAGE_SIZE ? ` (showing ${PAGE_SIZE})` : ""}.`
    );
  }

  // ── URL sync ─────────────────────────────────────────────────────────────────
  function syncUrl(term: string) {
    const params = new URLSearchParams(window.location.search);
    if (term) { params.set("q", term); }
    else      { params.delete("q"); }
    const qs = params.toString();
    history.replaceState(history.state, "", qs ? `?${qs}` : window.location.pathname);

    const root    = document.getElementById("pf-root");
    const backUrl = root?.dataset.backurl ?? "/";
    sessionStorage.setItem("backUrl", qs ? `${backUrl}?${qs}` : backUrl);
  }

  // ── init ─────────────────────────────────────────────────────────────────────
  function debounce(fn: () => void, ms: number): () => void {
    let t: ReturnType<typeof setTimeout> | undefined;
    return () => { clearTimeout(t); t = setTimeout(fn, ms); };
  }

  function init() {
    const root = document.getElementById("pf-root");
    if (!root || root.dataset.pfInit === "1") return;
    root.dataset.pfInit = "1";

    const input = document.getElementById("pf-input") as HTMLInputElement | null;
    if (!input) return;

    const debouncedSearch = debounce(() => {
      syncUrl(input.value.trim());
      doSearch();
    }, DEBOUNCE);

    // Spec 5: input change → re-search (debounced)
    input.addEventListener("input", () => debouncedSearch());

    // Spec 4: checkbox change → re-search (debounced)
    document.querySelectorAll<HTMLInputElement>(".pf-lang-cb").forEach(cb => {
      cb.addEventListener("change", () => debouncedSearch());
    });

    // Restore search from ?q= in URL
    const q = new URLSearchParams(window.location.search).get("q");
    if (q) { input.value = q; doSearch(); }
  }

  document.addEventListener("astro:after-swap", init);
  init();
</script>
