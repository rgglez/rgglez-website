---
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import { PUBLIC_GOOGLE_SITE_VERIFICATION } from "astro:env/client";
import Seo from "@rgglez/astro-seo";
import type { JsonLd } from "@rgglez/astro-seo/types";
import { SITE } from "@/config";
import "@/styles/global.css";

type Props = {
  title?: string;
  author?: string;
  profile?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string | URL;
  pubDatetime?: Date;
  modDatetime?: Date | null;
  scrollSmooth?: boolean;
  hreflangAlternates?: { hreflang: string; href: string }[];
  lang?: string;
  ogType?: string;
  jsonLd?: JsonLd;
};

const {
  title = SITE.title,
  author = SITE.author,
  profile = SITE.profile,
  description = SITE.desc,
  ogImage = SITE.ogImage ? `/${SITE.ogImage}` : "/og.png",
  canonicalURL = new URL(Astro.url.pathname, Astro.url),
  pubDatetime,
  modDatetime,
  scrollSmooth = false,
  hreflangAlternates,
  lang,
  ogType = pubDatetime ? "article" : "website",
  jsonLd,
} = Astro.props;

const pathLang = Astro.url.pathname.split("/")[1];
const supported = SITE.supportedLangs as readonly string[] | undefined;
const resolvedLang =
  lang ?? (supported?.includes(pathLang) ? pathLang : (SITE.lang ?? "en"));

// og:locale por idioma de la página (formato ll_TT de Open Graph).
const OG_LOCALES: Record<string, string> = {
  es: "es_MX",
  en: "en_US",
  fr: "fr_FR",
  de: "de_DE",
  zh: "zh_CN",
};
const ogLocale = OG_LOCALES[resolvedLang] ?? "en_US";

// Límites recomendados para vistas previas: og:title 60, og:description 160.
const truncate = (text: string, max: number) => {
  if (text.length <= max) return text;
  const cut = text.slice(0, max - 1);
  const lastSpace = cut.lastIndexOf(" ");
  // Cortar en el último espacio salvo que deje menos de la mitad del texto.
  return `${(lastSpace > max / 2 ? cut.slice(0, lastSpace) : cut).trimEnd()}…`;
};
const cleanTitle = title.endsWith(` | ${SITE.title}`)
  ? title.slice(0, -` | ${SITE.title}`.length)
  : title;
const ogTitle = truncate(cleanTitle, 60);
const ogDescription = truncate(description, 160);

const socialImageURL = new URL(ogImage, Astro.url);

const canonicalHref = canonicalURL.toString();
const socialImageHref = socialImageURL.toString();

const articleStructuredData = pubDatetime && {
  "@type": "BlogPosting",
  "@id": `${canonicalHref}#article`,
  headline: `${title}`,
  image: `${socialImageHref}`,
  datePublished: pubDatetime.toISOString(),
  ...(modDatetime && { dateModified: modDatetime.toISOString() }),
  url: canonicalHref,
  author: [
    {
      "@type": "Person",
      name: `${author}`,
      ...(profile && { url: profile }),
    },
  ],
};

const structuredData = jsonLd ?? articleStructuredData;
---

<!doctype html>
<html
  dir={SITE.dir}
  lang={resolvedLang}
  class={`${scrollSmooth && "scroll-smooth"}`}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />

    <!-- Load Fonts -->
    <Font
      cssVariable="--font-funnel-sans"
      preload={[{ subset: "latin", weight: 400, style: "normal" }]}
    />
    <Font
      cssVariable="--font-literata"
      preload={[{ subset: "latin", weight: 400, style: "normal" }]}
    />

    <Seo
      {title}
      {description}
      canonical={canonicalHref}
      languageAlternates={hreflangAlternates}
      openGraph={{
        title: ogTitle,
        description: ogDescription,
        url: canonicalHref,
        type: ogType,
        site_name: SITE.title,
        locale: ogLocale,
        images: [
          {
            url: socialImageHref,
            type: "image/jpeg",
            // PostDetails genera el JPEG a 1200x630; public/og.jpg mide igual.
            width: 1200,
            height: 630,
            alt: cleanTitle,
          },
        ],
        article: pubDatetime
          ? {
              published_time: pubDatetime.toISOString(),
              ...(modDatetime && { modified_time: modDatetime.toISOString() }),
            }
          : undefined,
      }}
      twitter={{
        card: "summary_large_image",
        title: ogTitle,
        description: ogDescription,
        image: socialImageHref,
      }}
      jsonLd={structuredData}
      additionalMetaTags={[
        { name: "title", content: title },
        { name: "author", content: author },
        { name: "twitter:url", content: canonicalHref },
      ]}
    />

    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Enable RSS feed auto-discovery  -->
    <!-- https://docs.astro.build/en/recipes/rss/#enabling-rss-feed-auto-discovery -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE.title}
      href={new URL("rss.xml", Astro.site)}
    />

    <!-- Katex -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css"
      integrity="sha384-n8MVd4RsNIU0tAv4ct0nTaAbDJwPJzDEaqSD1odI+WdtXRGWt2kTvGFasHpSy3SV"
      crossorigin="anonymous"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css"
        integrity="sha384-n8MVd4RsNIU0tAv4ct0nTaAbDJwPJzDEaqSD1odI+WdtXRGWt2kTvGFasHpSy3SV"
        crossorigin="anonymous"
      />
    </noscript>

    {
      // If PUBLIC_GOOGLE_SITE_VERIFICATION is set in the environment variable,
      // include google-site-verification tag in the heading
      // Learn more: https://support.google.com/webmasters/answer/9008080#meta_tag_verification&zippy=%2Chtml-tag
      PUBLIC_GOOGLE_SITE_VERIFICATION && (
        <meta
          name="google-site-verification"
          content={PUBLIC_GOOGLE_SITE_VERIFICATION}
        />
      )
    }

    <ClientRouter />

    <!-- Minimal inline script to prevent FOUC - sets theme immediately -->
    <script is:inline>
      (function () {
        const initialColorScheme = ""; // "light" | "dark"
        const currentTheme = localStorage.getItem("theme");

        function getPreferTheme() {
          if (currentTheme) return currentTheme;
          if (initialColorScheme) return initialColorScheme;
          return window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light";
        }

        const themeValue = getPreferTheme();

        // Set theme immediately to prevent flash
        document.firstElementChild?.setAttribute("data-theme", themeValue);

        // Export minimal API for external script
        window.theme = {
          themeValue: themeValue,
          getTheme: () => window.theme.themeValue,
          setTheme: val => {
            window.theme.themeValue = val;
          },
        };
      })();
    </script>

    <!-- Google tag (gtag.js) -->
    <script
      is:inline
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-YK7ZVRYWFW"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        // eslint-disable-next-line prefer-rest-params
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-YK7ZVRYWFW");

      document.addEventListener("astro:page-load", () => {
        gtag("event", "page_view", {
          page_location: window.location.href,
          page_title: document.title,
        });
      });
    </script>
  </head>
  <body>
    <slot />

    <!-- Load full theme logic -->
    <script src="../scripts/theme.ts"></script>
  </body>
</html>
