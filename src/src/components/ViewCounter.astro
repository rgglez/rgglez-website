---
import IconEye from "@/assets/icons/IconEye.svg";

interface Props {
  slug: string;
}
const { slug } = Astro.props;
---

<span
  class="inline-flex items-center gap-1 text-sm text-foreground/70"
  aria-live="polite"
>
  <IconEye class="inline-block size-6 min-w-5.5 flex-none" />
  <span id="view-count" data-slug={slug}>…</span>
</span>

<script>
  function loadViewCount() {
    const el = document.getElementById("view-count");
    if (!el) return;
    const slug = el.dataset.slug;
    fetch(`/api/views/${slug}`, { method: "POST" })
      .then((r) => r.json() as Promise<{ count: number }>)
      .then((d) => {
        el.textContent = new Intl.NumberFormat().format(d.count);
      })
      .catch(() => {
        el.textContent = "—";
      });
  }
  // astro:page-load corre en la carga inicial y tras cada navegación con ClientRouter.
  document.addEventListener("astro:page-load", loadViewCount);
</script>
