---
import { Image } from "astro:assets";

const { title, image: heroImage } = Astro.props;
// Local transforms can keep serving an earlier file from the immutable cache.
const devImage =
  import.meta.env.DEV && heroImage && typeof heroImage !== "string"
    ? heroImage
    : undefined;
---

{
  heroImage && (
    <div class="not-prose sheet-bleed mb-4 overflow-hidden">
      {devImage ? (
        <img
          src={devImage.src}
          width={devImage.width}
          height={devImage.height}
          alt={title}
          loading="eager"
          fetchpriority="high"
          class="block h-auto w-full border-0"
        />
      ) : (
        <Image
          src={heroImage}
          alt={title}
          loading="eager"
          fetchpriority="high"
          widths={[400, 800, 1200]}
          sizes="(max-width: 768px) 100vw, (max-width: 1280px) 928px, 1056px"
          class="block h-auto w-full border-0"
        />
      )}
    </div>
  )
}
