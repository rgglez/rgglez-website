---
type AsideType = "note" | "tip" | "caution" | "danger";

interface Props {
  type?: AsideType;
  title?: string;
}

const { type = "note", title } = Astro.props;

const variants: Record<
  AsideType,
  { label: string; container: string; icon: string; svg: string }
> = {
  note: {
    label: "Note",
    container:
      "border-sky-500/40 bg-sky-500/5 text-sky-900 dark:text-sky-100",
    icon: "text-sky-600 dark:text-sky-400",
    svg: `<path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25h.008v.008H11.25v-.008zM12 15.75h.008v.008H12v-.008zm9-3.75a9 9 0 11-18 0 9 9 0 0118 0z"/>`,
  },
  tip: {
    label: "Tip",
    container:
      "border-emerald-500/40 bg-emerald-500/5 text-emerald-900 dark:text-emerald-100",
    icon: "text-emerald-600 dark:text-emerald-400",
    svg: `<path stroke-linecap="round" stroke-linejoin="round" d="M12 18.75a6 6 0 006-6c0-1.658-.672-3.158-1.757-4.243A6 6 0 1012 18.75zm0 0v2.25m-3-2.25h6"/>`,
  },
  caution: {
    label: "Caution",
    container:
      "border-amber-500/40 bg-amber-500/5 text-amber-900 dark:text-amber-100",
    icon: "text-amber-600 dark:text-amber-400",
    svg: `<path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m0 3.75h.008M3.75 18.75h16.5a1.5 1.5 0 001.299-2.25L13.299 3.75a1.5 1.5 0 00-2.598 0L2.451 16.5a1.5 1.5 0 001.299 2.25z"/>`,
  },
  danger: {
    label: "Danger",
    container:
      "border-red-500/40 bg-red-500/5 text-red-900 dark:text-red-100",
    icon: "text-red-600 dark:text-red-400",
    svg: `<path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z"/>`,
  },
};

const v = variants[type];
const heading = title ?? v.label;
---

<aside
  class={`my-6 rounded-md border-l-4 px-4 py-3 ${v.container}`}
  role="note"
  aria-label={heading}
>
  <div class="mb-2 flex items-center gap-2 font-semibold">
    <svg
      class={`h-5 w-5 ${v.icon}`}
      xmlns="http://www.w3.org/2000/svg"
      fill="none"
      viewBox="0 0 24 24"
      stroke-width="1.75"
      stroke="currentColor"
      aria-hidden="true"
      set:html={v.svg}
    />
    <span>{heading}</span>
  </div>
  <div class="aside-content">
    <slot />
  </div>
</aside>

<style>
  .aside-content :global(p:first-child) {
    margin-top: 0;
  }
  .aside-content :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
