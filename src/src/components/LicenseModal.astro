---
import IconX from "@/assets/icons/IconX.svg";
import {
  DEFAULT_LICENSE,
  DEFAULT_LICENSE_URL,
  getLocalLicensePath,
} from "@/data/licenses";

type Props = {
  license?: string;
  licenseUrl?: string;
};

const { license = DEFAULT_LICENSE, licenseUrl = DEFAULT_LICENSE_URL } =
  Astro.props;

const localSrc = getLocalLicensePath(license);
---

<dialog
  id="license-modal"
  class:list={[
    "license-modal m-auto h-[min(90dvh,40rem)] w-[calc(100%-1.5rem)] max-w-3xl",
    "overflow-hidden",
    "rounded-lg border border-border bg-background text-foreground shadow-xl",
    "p-0 backdrop:bg-black/50 print:hidden",
  ]}
  aria-labelledby="license-modal-title"
  data-license-src={localSrc ?? ""}
>
  <div class="flex min-h-0 flex-1 flex-col">
    <div
      class="flex items-start justify-between gap-3 border-b border-border px-4 py-3 sm:px-5"
    >
      <div class="min-w-0">
        <h2
          id="license-modal-title"
          class="text-base font-semibold text-[#161d2e] dark:text-white"
        >
            License for original content:
            {
                licenseUrl && (
                <a href={licenseUrl} target="_blank" rel="noopener noreferrer">
                {license}
                </a>
                )
            }
        </h2>
        <p class="shrink-0 text-sm text-foreground/80">
            Non-original content is included or referenced under fair use.
        </p>
      </div>
      <button
        type="button"
        data-license-modal-close
        class="inline-flex size-11 shrink-0 items-center justify-center rounded-md text-foreground hover:bg-muted"
        aria-label="Close license"
      >
        <IconX class="size-5" />
      </button>
    </div>

    <div class="flex min-h-0 flex-1 flex-col gap-3 px-4 py-3 sm:px-5">
      <pre
        data-license-text
        class:list={[
          "license-text min-h-0 flex-1 overflow-y-scroll rounded-md",
          "border border-border bg-muted p-3 sm:p-4",
          "font-mono text-[0.7rem] leading-snug break-words whitespace-pre-wrap",
          "sm:text-xs",
        ]}
        style="font-family: ui-monospace, 'Courier New', Courier, monospace;">Loading license…</pre>
    </div>
  </div>
</dialog>

<script is:inline data-astro-rerun>
  function initLicenseModal() {
    if (document.documentElement.dataset.licenseModalInit) return;
    document.documentElement.dataset.licenseModalInit = "1";

    async function loadLicenseText(dialog) {
      const pre = dialog.querySelector("[data-license-text]");
      if (!(pre instanceof HTMLElement)) return;
      if (pre.dataset.loaded === "1") return;

      const src = dialog.getAttribute("data-license-src");
      if (!src) {
        pre.textContent =
          "The full text of this license is not bundled on this site. Use the official license link above.";
        pre.dataset.loaded = "1";
        return;
      }

      try {
        const response = await fetch(src);
        if (!response.ok) throw new Error(String(response.status));
        pre.textContent = await response.text();
        pre.dataset.loaded = "1";
      } catch {
        pre.textContent =
          "Could not load the local license text. Use the official license link above.";
      }
    }

    document.addEventListener("click", event => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      const dialog = document.getElementById("license-modal");
      if (!(dialog instanceof HTMLDialogElement)) return;

      const openTrigger = target.closest("[data-license-modal-open]");
      if (openTrigger) {
        if (
          event instanceof MouseEvent &&
          (event.button !== 0 ||
            event.metaKey ||
            event.ctrlKey ||
            event.shiftKey ||
            event.altKey)
        ) {
          return;
        }
        event.preventDefault();
        dialog.showModal();
        loadLicenseText(dialog);
        return;
      }

      if (target.closest("[data-license-modal-close]")) {
        dialog.close();
        return;
      }

      if (!dialog.open) return;

      const rect = dialog.getBoundingClientRect();
      const inside =
        event.clientX >= rect.left &&
        event.clientX <= rect.right &&
        event.clientY >= rect.top &&
        event.clientY <= rect.bottom;
      if (!inside) dialog.close();
    });

    document.addEventListener("astro:before-swap", () => {
      const dialog = document.getElementById("license-modal");
      if (dialog instanceof HTMLDialogElement && dialog.open) dialog.close();
    });
  }

  initLicenseModal();
</script>

<style>
  /* `display` must stay `none` while closed, or the dialog is always visible. */
  #license-modal[open] {
    display: flex;
    flex-direction: column;
  }

  #license-modal [data-license-text] {
    scrollbar-gutter: stable;
    scrollbar-width: thin;
    scrollbar-color: var(--foreground) var(--border);
  }
  #license-modal [data-license-text]::-webkit-scrollbar {
    width: 10px;
  }
  #license-modal [data-license-text]::-webkit-scrollbar-track {
    background: var(--border);
    border-radius: 4px;
  }
  #license-modal [data-license-text]::-webkit-scrollbar-thumb {
    background: var(--foreground);
    border-radius: 4px;
  }
</style>
